# Server only. Create a dedicated Supabase project and apply supabase/schema.sql.
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Never use a VITE_ or NEXT_PUBLIC_ prefix for secrets.
ADMIN_PASSWORD=
CRON_SECRET=
# Migration only; never required by the new application.
BLOB_READ_WRITE_TOKEN=
# Optional isolated local PostgreSQL for development (never enabled on Vercel).
# LOCAL_DATABASE_PATH=work/local-db
